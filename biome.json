{
  "files": { "ignoreUnknown": false },
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": { "cssModules": false, "tailwindDirectives": true },
    "formatter": { "enabled": true },
    "linter": { "enabled": true }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "overrides": [
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./**", "../**"],
                    "message": "Use absolute imports with @/ so the import rules can check them."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/api/**", "src/components/**", "src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/**", "@/app/**", "./**", "../**"],
                    "message": "Shared code (api, components, lib) cannot import features or app."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/about/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/**", "!@/features/about/**", "@/app/**", "./**", "../**"],
                    "message": "A feature imports only its own folder and shared code (api, components, lib)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/contact/**"],
      "linter": {
        "rules": {
