            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "!@/features/contact/**",
                      "@/app/**",
                      "./**",
                      "../**"
                    ],
                    "message": "A feature imports only its own folder and shared code (api, components, lib)."
                  }
                ]
              }
            }
          }
        }
      }
    },
