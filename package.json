{
  "name": "agranadosb-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev",
    "lint": "biome lint",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "check": "biome check",
    "check-format": "biome format",
    "audit": "npm audit --audit-level=high",
    "sync-ai-instructions": "sed 's/# Portfolio — Claude working guide/# Portfolio — Copilot instructions/' CLAUDE.md > .github/copilot-instructions.md && sed 's/# Portfolio — Claude working guide/# Portfolio — Agent instructions/' CLAUDE.md > AGENTS.md",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@cloudflare/vite-plugin": "^1.36.3",
    "@tailwindcss/vite": "^4.1.9",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "tailwindcss": "^4.1.9",
    "typescript": "^5.8.3",
    "vite": "^7.2.7",
    "wrangler": "^4.90.0"
  }
}
